# Telegram: створи бота у @BotFather -> токен сюди.
TELEGRAM_BOT_TOKEN=
# Напиши своєму боту /id — він відповість твоїм chat_id.
# Особистий чат (рекомендовано): кнопки Mini App працюють прямо під лідами.
# Група з партнером (-100…): пуші працюють, Mini App відкривається з особистого чату з ботом.
TELEGRAM_CHAT_ID=
# Хто має доступ до Mini App (Telegram user id через кому). Порожньо = власник TELEGRAM_CHAT_ID.
# Партнер теж хоче — додай його id (він дізнається свій через /id в особистому чаті з ботом).
TELEGRAM_ALLOWED_USERS=

# HTTPS-адреса сервера = адреса Mini App (та сама, що в Caddyfile)
PUBLIC_URL=https://lovec.65.21.10.5.sslip.io

# Вхід з браузера (поза Telegram), basic auth
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please

# AI-підсумок у Mini App. Достатньо ОДНОГО ключа. Без ключа кнопка просто не з'явиться.
# Безкоштовно, без картки: console.groq.com → API Keys
GROQ_API_KEY=
# або безкоштовно: aistudio.google.com → Get API key
GEMINI_API_KEY=
# або платно (найкраща якість): console.anthropic.com
ANTHROPIC_API_KEY=
# Модель (необов'язково). Groq: openai/gpt-oss-120b, Gemini: gemini-3.8-flash, Claude: claude-haiku-5-5
AI_MODEL=

LOG_LEVEL=INFO
