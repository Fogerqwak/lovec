# Telegram: створи бота у @BotFather -> токен сюди.
TELEGRAM_BOT_TOKEN=
# Напиши своєму боту /start — він відповість твоїм chat_id (коли Lovec запущено).
# Або додай бота в групу з партнером і візьми id групи (починається з -100…).
TELEGRAM_CHAT_ID=

# Дашборд (basic auth)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please

# Адреса дашборду для посилань у Telegram (необов'язково)
PUBLIC_URL=https://lovec.example.com

LOG_LEVEL=INFO
